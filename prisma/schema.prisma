generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── INSUMOS (Base de Dados da planilha) ───────────────────────────────────
model Insumo {
  id                  Int      @id @default(autoincrement())
  codigo              Int      @unique               // código numérico da planilha (1-99)
  nome                String
  unidadeMedida       String                          // KG, Unid, L, ml, g
  rsPago              Decimal  @db.Decimal(10, 4)    // R$ pago pela embalagem
  volumeEmbalagem     Decimal  @db.Decimal(10, 4)    // quantidade na embalagem
  estoqueAtual        Decimal  @db.Decimal(10, 4)    @default(0)
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  // custo por unidade = rsPago / volumeEmbalagem (calculado na app)
  produtoInsumos      ProdutoInsumo[]

  @@map("insumos")
}

// ─── DESPESAS (Sheet Despesas da planilha) ──────────────────────────────────
model Despesa {
  id           Int     @id @default(autoincrement())
  descricao    String
  tipo         String                                // "fixa" | "variavel"
  valor        Decimal @db.Decimal(10, 2)           // R$ para fixas, % para variáveis
  ativo        Boolean @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("despesas")
}

// ─── PRODUTOS / FICHAS TÉCNICAS ─────────────────────────────────────────────
model Produto {
  id                  Int      @id @default(autoincrement())
  codigo              Int?     @unique               // código 100+ da planilha
  nome                String
  categoria           String                          // "Salão", "Petisco", "iFood", "Embalagem"
  descricao           String?
  rendimentoPorcoes   Decimal  @db.Decimal(10, 3)   @default(1)  // qtd de porções que a receita rende
  obsPorcao           String?
  margemSeguranca     Decimal  @db.Decimal(5, 2)    @default(10) // % (padrão 10%)
  precoVenda          Decimal? @db.Decimal(10, 2)               // preço praticado (salão)
  precoIfood          Decimal? @db.Decimal(10, 2)               // preço praticado no iFood (pode diferir)
  disponivelIfood     Boolean  @default(true)                   // se aparece no PDV iFood
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  insumos   ProdutoInsumo[]
  itensVenda ItemVenda[]

  @@map("produtos")
}

// ─── PRODUTO x INSUMO (Ficha Técnica) ───────────────────────────────────────
model ProdutoInsumo {
  id              Int     @id @default(autoincrement())
  produtoId       Int
  insumoId        Int
  qtdBruta        Decimal @db.Decimal(10, 4)         // quantidade usada na receita
  qtdLiquida      Decimal? @db.Decimal(10, 4)        // após limpeza/cocção
  fatorCorrecao   Decimal? @db.Decimal(10, 4)        // fator de rendimento (fc)
  medidaCaseira   String?

  produto  Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo   Insumo  @relation(fields: [insumoId], references: [id])

  @@unique([produtoId, insumoId])
  @@map("produto_insumos")
}

// ─── VENDAS ──────────────────────────────────────────────────────────────────
model Venda {
  id           Int        @id @default(autoincrement())
  canal        String     @default("salao")   // "salao" | "ifood" | "balcao"
  total        Decimal    @db.Decimal(10, 2)
  criadaEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  itens ItemVenda[]

  @@map("vendas")
}

model ItemVenda {
  id             Int     @id @default(autoincrement())
  vendaId        Int
  produtoId      Int
  quantidade     Int
  precoUnitario  Decimal @db.Decimal(10, 2)

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_venda")
}

// ─── FATURAMENTO MENSAL (Sheet Despesas - Faturamento do Ano) ────────────────
model FaturamentoMensal {
  id         Int      @id @default(autoincrement())
  ano        Int
  mes        Int                                // 1-12
  valor      Decimal  @db.Decimal(12, 2)
  criadoEm   DateTime @default(now())

  @@unique([ano, mes])
  @@map("faturamento_mensal")
}
