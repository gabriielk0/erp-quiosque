# Copie este arquivo para .env e preencha com suas credenciais do Neon

# Neon Postgres — pegue em: https://console.neon.tech > seu projeto > Connection Details
# Use "Pooled connection" para DATABASE_URL e "Direct connection" para DIRECT_URL

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
