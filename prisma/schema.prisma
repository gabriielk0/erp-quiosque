generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── CONFIGURAÇÕES GLOBAIS ──────────────────────────────────────────────────
model ConfiguracaoSistema {
  id                Int      @id @default(autoincrement())
  margemLucroPadrao Decimal  @db.Decimal(5, 4) @default(0.1823) // 18.23%
  markupPadrao      Decimal  @db.Decimal(5, 2) @default(2.8)
  cmvMaximo         Decimal  @db.Decimal(5, 4) @default(0.375)  // 37.5%
  atualizadoEm      DateTime @updatedAt

  @@map("configuracao_sistema")
}

// ─── INSUMOS (Base de Dados da planilha) ───────────────────────────────────
model Insumo {
  id                  Int      @id @default(autoincrement())
  codigo              Int      @unique               // código numérico da planilha (1-99)
  nome                String
  unidadeMedida       String                          // KG, Unid, L, ml, g
  rsPago              Decimal  @db.Decimal(10, 4)    // R$ pago pela embalagem
  volumeEmbalagem     Decimal  @db.Decimal(10, 4)    // quantidade na embalagem
  estoqueAtual        Decimal  @db.Decimal(10, 4)    @default(0)
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  // custo por unidade = rsPago / volumeEmbalagem (calculado na app)
  produtoInsumos      ProdutoInsumo[]
  itensVenda          ItemVenda[]

  @@map("insumos")
}

// ─── DESPESAS (Sheet Despesas da planilha) ──────────────────────────────────
model Despesa {
  id           Int     @id @default(autoincrement())
  descricao    String
  tipo         String                                // "fixa" | "variavel"
  valor        Decimal @db.Decimal(10, 2)           // R$ para fixas, % para variáveis
  ativo        Boolean @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("despesas")
}

// ─── PRODUTOS / FICHAS TÉCNICAS ─────────────────────────────────────────────
model Produto {
  id                  Int      @id @default(autoincrement())
  codigo              Int?     @unique               // código 100+ da planilha
  nome                String
  categoria           String                          // "Salão", "Petisco", "iFood", "Embalagem"
  descricao           String?
  rendimentoPorcoes   Decimal  @db.Decimal(10, 3)   @default(1)  // qtd de porções que a receita rende
  obsPorcao           String?
  margemSeguranca     Decimal? @db.Decimal(5, 2)                 // % (se null, usa padrão)
  precoVenda          Decimal? @db.Decimal(10, 2)               // preço praticado (salão)
  precoIfood          Decimal? @db.Decimal(10, 2)               // preço praticado no iFood (pode diferir)
  disponivelIfood     Boolean  @default(true)                   // se aparece no PDV iFood
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  insumos   ProdutoInsumo[]
  itensVenda ItemVenda[]

  @@map("produtos")
}

// ─── PRODUTO x INSUMO (Ficha Técnica) ───────────────────────────────────────
model ProdutoInsumo {
  id              Int     @id @default(autoincrement())
  produtoId       Int
  insumoId        Int
  qtdBruta        Decimal @db.Decimal(10, 4)         // quantidade usada na receita
  qtdLiquida      Decimal? @db.Decimal(10, 4)        // após limpeza/cocção
  fatorCorrecao   Decimal? @db.Decimal(10, 4)        // fator de rendimento (fc)
  medidaCaseira   String?

  produto  Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo   Insumo  @relation(fields: [insumoId], references: [id])

  @@unique([produtoId, insumoId])
  @@map("produto_insumos")
}

// ─── VENDAS ──────────────────────────────────────────────────────────────────
model Venda {
  id            Int      @id @default(autoincrement())
  canal         String   @default("salao") // "salao" | "ifood" | "balcao"
  subtotal      Decimal  @db.Decimal(10, 2) @default(0)
  desconto      Decimal  @db.Decimal(10, 2) @default(0)
  taxaAdicional Decimal  @db.Decimal(10, 2) @default(0)
  total         Decimal  @db.Decimal(10, 2)
  observacoes   String?  @db.Text
  criadaEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  itens ItemVenda[]

  @@map("vendas")
}

model ItemVenda {
  id                   Int      @id @default(autoincrement())
  vendaId              Int
  produtoId            Int?
  insumoId             Int?
  nomeCustom           String?
  quantidade           Int
  precoUnitario        Decimal  @db.Decimal(10, 2)
  custoUnitarioInsumos Decimal  @db.Decimal(10, 4) @default(0)

  venda   Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id])
  insumo  Insumo?  @relation(fields: [insumoId], references: [id])

  @@map("itens_venda")
}

// ─── FATURAMENTO MENSAL (Sheet Despesas - Faturamento do Ano) ────────────────
model FaturamentoMensal {
  id         Int      @id @default(autoincrement())
  ano        Int
  mes        Int                                // 1-12
  valor      Decimal  @db.Decimal(12, 2)
  criadoEm   DateTime @default(now())

  @@unique([ano, mes])
  @@map("faturamento_mensal")
}

// ─── GESTÃO FINANCEIRA DINÂMICA ─────────────────────────────────────────────

enum CategoryType {
  FIXED     // Custo Fixo (Absoluto em R$)
  VARIABLE  // Custo Variável (Alíquota em %)
}

model ExpenseCategory {
  id           Int             @id @default(autoincrement())
  nome         String          @unique
  tipo         CategoryType
  ativo        Boolean         @default(true)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  records      FinancialRecord[]

  @@map("expense_categories")
}

model FinancialRecord {
  id           Int             @id @default(autoincrement())
  descricao    String
  valor        Decimal         @db.Decimal(12, 4) // R$ se tipo FIXED, alíquota (%) se tipo VARIABLE
  ano          Int
  mes          Int             // 1-12
  categoriaId  Int
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  categoria    ExpenseCategory @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@map("financial_records")
}

model MonthlyRevenue {
  id           Int             @id @default(autoincrement())
  ano          Int
  mes          Int             // 1-12
  faturamento  Decimal         @db.Decimal(12, 2)
  cmvMeta      Decimal         @db.Decimal(5, 4) @default(0.3500)  // 35%
  lucroMeta    Decimal         @db.Decimal(5, 4) @default(0.2000)  // 20%
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  @@unique([ano, mes])
  @@map("monthly_revenues")
}
